# Normalise line endings so a Windows checkout and a Linux CI runner agree.
* text=auto

# The Gradle wrapper script is executed by /bin/sh on Linux and macOS: CRLF endings would
# make it fail with "bad interpreter".
gradlew text eol=lf
*.sh text eol=lf

gradlew.bat text eol=crlf

*.jar binary
*.png binary
